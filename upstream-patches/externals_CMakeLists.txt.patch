# carried local patch for the upstream mirror
# file: externals/CMakeLists.txt
# original base: 388cff5177f82e75a667d529212d34f3c255b7fc
diff --git a/externals/CMakeLists.txt b/externals/CMakeLists.txt
index e7944af6..c9cde9cd 100644
--- a/externals/CMakeLists.txt
+++ b/externals/CMakeLists.txt
@@ -383,6 +383,19 @@ if (APPLE AND NOT ENABLE_SYSTEM_VULKAN AND NOT ENABLE_TESTS)
 endif()
 
 # abseil (for protobuf)
+if(MSVC)
+    # GR2FORK FIX: abseil's own CMakeLists overwrites CMAKE_MSVC_RUNTIME_LIBRARY for
+    # its whole subtree from this option, ignoring the umbrella's value, and defaults
+    # to the DLL runtime. The Windows cores build everything with the static CRT, so
+    # leaving it OFF makes the absl objects the lone /MD set and protoc fails to link
+    # ("/failifmismatch: mismatch detected for 'RuntimeLibrary'"). Follow the umbrella
+    # CRT choice, the same way protobuf_MSVC_STATIC_RUNTIME does.
+    if(CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL")
+        set(ABSL_MSVC_STATIC_RUNTIME ON  CACHE BOOL "" FORCE)
+    else()
+        set(ABSL_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
+    endif()
+endif()
 if (NOT TARGET absl::strings)
     add_subdirectory(abseil-cpp EXCLUDE_FROM_ALL)
 endif()
@@ -397,7 +410,17 @@ set(protobuf_BUILD_SHARED_LIBS        OFF CACHE INTERNAL "")
 set(protobuf_LOCAL_DEPENDENCIES_ONLY  ON  CACHE INTERNAL "")
 set(protobuf_FORCE_FETCH_DEPENDENCIES OFF CACHE INTERNAL "")
 if(MSVC)
-set(protobuf_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
+    # GR2FORK FIX: protobuf derives CMAKE_MSVC_RUNTIME_LIBRARY for its whole
+    # subtree (abseil and utf8_range included) from this option, ignoring the
+    # umbrella's value. The Windows cores build everything with the static CRT,
+    # so forcing this OFF leaves libprotobuf.lib as the lone /MD object set and
+    # the core DLLs fail to link ("/failifmismatch: mismatch detected for
+    # 'RuntimeLibrary'"). Follow the umbrella CRT choice instead.
+    if(CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL")
+        set(protobuf_MSVC_STATIC_RUNTIME ON CACHE BOOL "" FORCE)
+    else()
+        set(protobuf_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
+    endif()
 endif()
 add_subdirectory(protobuf EXCLUDE_FROM_ALL)
 
